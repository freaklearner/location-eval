  "scoringRules": {
    "excellent": { "min": 4.5, "description": "Exceptional for business" },
    "good": { "min": 3.5, "description": "Good potential" },
    "average": { "min": 2.5, "description": "Average conditions" },
    "poor": { "min": 1.5, "description": "Below average" },
    "very_poor": { "min": 0, "description": "Not suitable" }
  },
  "viabilityThresholds": {
    "highly_recommended": { "min": 80, "grade": "A" },
    "recommended": { "min": 70, "grade": "B" },
    "conditional": { "min": 60, "grade": "C" },
    "not_recommended": { "min": 0, "grade": "D" }
  }
