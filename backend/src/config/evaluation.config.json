        "4": { "description": "Index 65-79, intl fast fashion ≥1", "indicators": ["premium high street", "median URT ≥400"] },
        "5": { "description": "Index ≥80, luxury brands ≥1-2", "indicators": ["luxury retail node", "median URT ≥700"] }
      }
    },
    {
      "id": "fitness_gym_walking_culture",
      "name": "Fitness/Gym/Walking Culture",
      "description": "Health and fitness consciousness indicating lifestyle preferences",
      "weight": 2,
      "category": "medium_priority",
