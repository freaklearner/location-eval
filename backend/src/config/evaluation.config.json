      "description": "Delivery ecosystem strength for online orders",
      "weight": 15,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["restaurant", "cafe", "bakery", "fast_food", "meal_takeaway", "meal_delivery"],
        "keywords": {
