        "4": { "description": "High-rise towers, branded developers, full amenities", "indicators": ["premium gated", "clubhouse", "gym", "security"] },
        "5": { "description": "Golf course facing, luxury villas, mega townships", "indicators": ["luxury townships", "premium amenities", "ratings >4.3"] }
      }
    },
    {
      "id": "shopping_preferences_nearby",
      "name": "Shopping Preferences Nearby",
      "description": "Retail sophistication and shopping behavior patterns",
      "weight": 3,
      "category": "medium_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["shopping_mall", "clothing_store", "shoe_store", "department_store", "jewelry_store", "supermarket"],
        "keywords": {
          "budget": ["Vishal Mega Mart", "Easybuy", "Max", "factory outlet", "wholesale"],
          "mid": ["Lifestyle", "Westside", "Pantaloons", "Levi's", "Metro Shoes"],
