        "4": { "description": "Index 65-79, D_count 40-60, ≥4 national brands", "indicators": ["dense delivery hub", "cloud kitchens ≥2", "late-night ≥5"] },
        "5": { "description": "Index ≥80, D_count ≥60, cloud kitchen clusters ≥4", "indicators": ["prime delivery hotspot", "multiple high-URT nodes"] }
      }
    },
    {
      "id": "student_vs_office_crowd_mix",
      "name": "Student vs Office Crowd Mix",
      "description": "Balance between student and office demographics",
      "weight": 5,
      "category": "medium_priority",
      "searchRadius": [400, 800, 1200],
      "calculationMethod": "ratio_analysis",
