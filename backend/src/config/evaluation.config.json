{
  "evaluationFramework": {
    "version": "2.0",
    "description": "New 7-step framework with 5-slab scoring system for location evaluation",
    "maxScore": 100,
    "slabSystem": {
      "1": { "name": "Budget/Mass", "range": [0, 20], "description": "Budget/street-heavy catchment" },
      "2": { "name": "Entry-level", "range": [21, 40], "description": "Basic organized presence" },
      "3": { "name": "Mid-market", "range": [41, 60], "description": "Balanced mid catchment" },
      "4": { "name": "Premium", "range": [61, 80], "description": "Premium organized hub" },
      "5": { "name": "Luxury/Elite", "range": [81, 100], "description": "Luxury/elite destination" }
    }
  },
  "evaluationParameters": [
    {
      "id": "petrol_pump_nearby",
      "name": "Petrol Pump Nearby",
      "description": "Quality of nearby petrol pumps as footfall indicators",
      "weight": 1,
      "category": "supportive",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["gas_station"],
        "keywords": ["petrol pump", "fuel station", "Indian Oil", "HP", "BPCL", "Reliance", "Shell", "Nayara"]
      },
      "slabCriteria": {
        "1": { "description": "Small local pump, 1-2 bays, no add-ons, URT <50", "indicators": ["basic pump", "no convenience store", "limited hours"] },
        "2": { "description": "Normal PSU pump, limited bays, basic facilities", "indicators": ["Indian Oil/HP/BPCL", "basic air/washroom"] },
        "3": { "description": "Standard organized pump, multiple bays, URT ~100-200", "indicators": ["multiple bays", "ATM", "car wash", "24x7"] },
        "4": { "description": "Premium pump hub with convenience store + F&B", "indicators": ["Shell/Reliance/Nayara", "convenience store", "clean washrooms", "URT ≥200"] },
        "5": { "description": "Destination pump complex with McDonald's/KFC + services", "indicators": ["mega pump", "McDonald's/KFC/Subway", "service station", "URT ≥500"] }
      }
    },
    {
      "id": "food_brand_presence",
      "name": "Food Brand Presence",
      "description": "Quality and tier of food brands indicating catchment maturity",
      "weight": 5,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["restaurant", "cafe", "fast_food", "meal_takeaway", "meal_delivery", "bakery", "food_court"],
        "keywords": {
          "global_qsr": ["McDonald's", "Burger King", "KFC", "Pizza Hut", "Domino's", "Papa John's", "Subway", "Starbucks", "Costa", "Dunkin Donuts"],
          "indian_national": ["Wow! Momo", "Biryani Blues", "Behrouz Biryani", "Faasos", "Box8", "Oven Story", "Sagar Ratna", "Haldiram's", "CCD", "Chaayos"],
          "regional": ["Nirula's", "Karim's", "Paradise Biryani", "Truffles", "Empire", "Natural Ice Cream"],
          "local_street": ["momo stall", "chaat corner", "rolls", "dhaba", "snack corner"]
        }
      },
      "slabCriteria": {
        "1": { "description": "90%+ outlets local, no branded chains", "weightage": { "global_qsr": 0, "indian_national": 0, "regional": 0, "local_street": 100 } },
        "2": { "description": "1-2 regional chains, mostly local, no global/national QSR", "weightage": { "global_qsr": 0, "indian_national": 10, "regional": 20, "local_street": 70 } },
        "3": { "description": "2-3 national chains or 4+ regional, local strong", "weightage": { "global_qsr": 10, "indian_national": 30, "regional": 30, "local_street": 30 } },
        "4": { "description": "3-4 global QSR + 4+ national chains", "weightage": { "global_qsr": 40, "indian_national": 40, "regional": 15, "local_street": 5 } },
        "5": { "description": "Multiple global QSR (≥5) + multiple national chains", "weightage": { "global_qsr": 60, "indian_national": 30, "regional": 8, "local_street": 2 } }
      }
    },
    {
      "id": "clothing_brand_presence",
      "name": "Clothing Brand Presence",
      "description": "Clothing retail maturity indicating spending capacity",
      "weight": 3,
      "category": "medium_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["clothing_store", "department_store", "shopping_mall", "store"],
        "keywords": {
          "luxury": ["Louis Vuitton", "Gucci", "Dior", "Chanel", "Hermès", "Prada", "Burberry", "Armani"],
          "premium": ["Zara", "H&M", "Uniqlo", "Massimo Dutti", "Mango", "Marks & Spencer", "Tommy Hilfiger", "Calvin Klein"],
          "national": ["Lifestyle", "Westside", "Shoppers Stop", "Pantaloons", "Raymond", "Van Heusen", "Levi's", "Fabindia"],
          "value": ["Zudio", "Reliance Trends", "Max Fashion", "Easybuy", "V-Mart"]
        }
      },
      "slabCriteria": {
        "1": { "description": "Value chains + local boutiques, no anchors/intl", "indicators": ["local boutiques", "no branded chains", "low URT"] },
        "2": { "description": "Zudio/Max/Trends present, single anchor possible", "indicators": ["value chains", "single anchor", "no intl fast fashion"] },
        "3": { "description": "2+ anchors, denim/formal brands cluster", "indicators": ["Lifestyle/Westside", "denim brands", "limited intl"] },
        "4": { "description": "Zara/H&M/Uniqlo ≥1, anchors ≥2", "indicators": ["intl fast fashion", "multiple anchors", "URT↑"] },
        "5": { "description": "1-2+ luxury mono-brands + intl fast fashion 2+", "indicators": ["luxury brands", "premium mall corridor", "high URT"] }
      }
    },
    {
      "id": "footwear_brand_presence",
      "name": "Footwear Brand Presence",
      "description": "Footwear retail indicating affluence and shopping behavior",
      "weight": 2,
      "category": "medium_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["shoe_store", "store", "shopping_mall"],
        "keywords": {
          "luxury": ["Christian Louboutin", "Jimmy Choo", "Salvatore Ferragamo", "Tod's", "Bally"],
          "premium": ["Nike", "Adidas", "Puma", "New Balance", "Aldo", "Steve Madden", "Clarks"],
          "mid": ["Metro Shoes", "Mochi", "Regal", "Bata", "Red Tape", "Liberty"],
          "budget": ["Relaxo", "Paragon", "Campus", "Action"]
        }
      },
      "slabCriteria": {
        "1": { "description": "Local/value brands dominate, discount/wholesale heavy", "indicators": ["budget brands", "wholesale", "low URT"] },
        "2": { "description": "Bata/Liberty/Khadim's cluster, few mid MBO", "indicators": ["organized value", "no global sports"] },
        "3": { "description": "Metro/Mochi + Hush Puppies/Clarks, some sports", "indicators": ["mid organized", "some sports brands"] },
        "4": { "description": "Nike/Adidas/Puma + Aldo/Steve Madden", "indicators": ["global sports", "premium brands", "higher URT"] },
        "5": { "description": "Louboutin/Jimmy Choo/Ferragamo present", "indicators": ["luxury footwear", "premium mall/high street"] }
      }
    },
    {
      "id": "nearby_schools_colleges",
      "name": "Nearby Schools/Colleges",
      "description": "Educational institutions indicating student footfall potential",
      "weight": 7,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["school", "secondary_school", "primary_school", "university", "college", "library", "book_store", "training", "institute"],
        "keywords": {
          "premium_schools": ["DPS", "Ryan International", "GD Goenka", "Amity", "Pathways"],
          "cbse_icse": ["St. Xavier's", "St. Mary's", "DAV", "Birla Vidya Niketan"],
          "universities": ["Delhi University", "Amity University", "Symbiosis", "Christ", "IIT", "NIT"],
          "coaching": ["Aakash", "Allen", "FIITJEE", "Byju's", "Career Launcher", "Resonance"]
        }
      },
      "slabCriteria": {
        "1": { "description": "Only 1-2 small local schools, no college/coaching", "indicators": ["local schools", "URT <50", "basic facilities"] },
        "2": { "description": "2-3 small schools + 1 coaching institute", "indicators": ["budget schools", "affordable fees", "basic facilities"] },
        "3": { "description": "Mix of 2-3 reputed schools + 1-2 colleges OR 3-5 coaching", "indicators": ["reputed schools", "canteen", "hostel nearby"] },
        "4": { "description": "≥3 reputed schools + 2 colleges/universities OR 5+ coaching", "indicators": ["strong education hub", "crowded with students", "URT ≥300"] },
        "5": { "description": "University cluster OR famous coaching hub", "indicators": ["university cluster", "10+ coaching", "heavy student footfall"] }
      }
    },
    {
      "id": "footfall",
      "name": "Footfall",
      "description": "Overall pedestrian and customer traffic density",
      "weight": 18,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "calculationMethod": "composite",
      "components": {
        "digital_proxies": {
          "weight": 40,
          "indicators": ["google_reviews_count", "popular_times", "category_mix", "transport_access"]
        },
        "economic_proxies": {
          "weight": 35,
          "indicators": ["rent_per_sqft", "avg_ticket_size", "brand_presence"]
        },
        "physical_proxies": {
          "weight": 25,
          "indicators": ["vehicle_mix", "pedestrian_count", "weekly_bazaar", "mobile_tower_density"]
        }
      },
      "slabCriteria": {
        "1": { "description": "90% 2-wheelers, govt schools, reviews <50, rent <₹50/sqft", "indicators": ["mass footfall", "daily wage crowd", "low spending"] },
        "2": { "description": "70% 2W, budget schools, reviews 50-200, rent ₹50-100/sqft", "indicators": ["budget footfall", "small town salaried", "shopkeepers"] },
        "3": { "description": "50% 2W + 50% cars, CBSE schools, reviews 200-500", "indicators": ["mid market footfall", "middle-class families", "students"] },
        "4": { "description": "Cars/SUVs dominate, premium schools, reviews 500-1000", "indicators": ["premium footfall", "upper middle class", "aspirational youth"] },
        "5": { "description": "SUVs + luxury cars, elite schools, reviews >1000", "indicators": ["elite footfall", "affluent", "high spenders"] }
      }
    },
    {
      "id": "target_audience_fit",
      "name": "Target Audience Fit",
      "description": "Alignment with target demographics (Students, Office, Families, Aspirational Youth)",
      "weight": 10,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "audienceSegments": {
        "students_youth": {
          "weight": 30,
          "indicators": ["schools", "colleges", "coaching", "budget_cafes"],
          "keywords": ["university", "college", "coaching center", "Chai Sutta", "MBA Chaiwala"]
        },
        "office_crowd": {
          "weight": 30,
          "indicators": ["offices", "coworking", "business_parks", "lunch_cafes"],
          "keywords": ["IT Park", "Business Park", "co-working", "WeWork", "Awfis"]
        },
        "families": {
          "weight": 20,
          "indicators": ["apartments", "societies", "parks", "schools", "grocery"],
          "keywords": ["apartment", "society", "township", "park", "supermarket"]
        },
        "aspirational_youth": {
          "weight": 20,
          "indicators": ["premium_cafes", "gyms", "malls", "bars"],
          "keywords": ["Starbucks", "Blue Tokai", "premium gym", "Zara", "H&M"]
        }
      },
      "slabCriteria": {
        "1": { "description": "TAF <35, price_level 0-1, mostly local stalls", "range": [0, 35] },
        "2": { "description": "TAF 35-50, some private schools/coaching", "range": [35, 50] },
        "3": { "description": "TAF 50-65, students+offices visible", "range": [50, 65] },
        "4": { "description": "TAF 65-80, co-working/IT hubs + premium cafés", "range": [65, 80] },
        "5": { "description": "TAF 80+, premium cafés cluster, international schools", "range": [80, 100] }
      }
    },
    {
      "id": "competition_pricing_momo",
      "name": "Competition Pricing (Momo)",
      "description": "Momo competition analysis and pricing landscape",
      "weight": 8,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "keywords": ["momo", "momos", "dumpling", "restaurant", "cafe"],
        "competition_types": {
          "direct": ["momo", "momos", "dumpling", "wow momo", "tibetan", "steamed momo"],
          "indirect": ["chaat", "samosa", "roll", "sandwich", "burger", "chinese", "fast food"]
        }
      },
      "slabCriteria": {
        "1": { "description": "Price_level 0-1, avg momo plate ≤₹70-80", "indicators": ["budget pricing", "street carts", "daily-wage audience"] },
        "2": { "description": "Price_level 1-2, momo plate ₹80-120", "indicators": ["entry-level organized", "local cloud kitchens", "reasonable pricing"] },
        "3": { "description": "Price_level 2, momo plate ₹120-180", "indicators": ["mid-market pricing", "Wow! Momo", "branded kiosks"] },
        "4": { "description": "Price_level 2-3, momo plate ₹180-250", "indicators": ["premium casual", "premium cafés", "good ambience"] },
        "5": { "description": "Price_level 3-4, momo plate ₹250+", "indicators": ["elite pricing", "fine dining", "luxury hotels"] }
      }
    },
    {
      "id": "spending_capacity",
      "name": "Spending Capacity",
      "description": "Local spending power and economic indicators",
      "weight": 12,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "calculationMethod": "composite",
      "indicators": {
        "vehicle_mix": { "weight": 30, "description": "Car/SUV vs 2-wheeler ratio" },
        "housing_quality": { "weight": 25, "description": "Society/apartment quality" },
        "brand_presence": { "weight": 25, "description": "Premium vs budget brand mix" },
        "price_levels": { "weight": 20, "description": "Average price_level of nearby businesses" }
      },
      "slabCriteria": {
        "1": { "description": "90% 2W, basic housing, budget brands", "indicators": ["mass market", "low spending", "price sensitive"] },
        "2": { "description": "70% 2W, small apartments, few mid brands", "indicators": ["lower middle class", "budget conscious"] },
        "3": { "description": "50-50 2W/cars, gated societies, national brands", "indicators": ["middle class", "balanced spending"] },
        "4": { "description": "Car/SUV majority, premium societies, intl brands", "indicators": ["upper middle class", "aspirational spending"] },
        "5": { "description": "Luxury cars, high-end societies, luxury brands", "indicators": ["affluent", "high discretionary spending"] }
      }
    },
    {
      "id": "nearby_businesses_offices",
      "name": "Nearby Businesses/Offices",
      "description": "Office and business presence for lunch crowd and repeat customers",
      "weight": 7,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["office", "business_park", "coworking_space", "bank", "atm", "courier"],
        "keywords": {
          "it_parks": ["IT park", "technology park", "software park", "business park", "SEZ"],
          "coworking": ["WeWork", "Awfis", "Regus", "Smartworks", "IndiQube", "91Springboard"],
          "offices": ["corporate office", "head office", "regional office", "branch office"],
          "support": ["bank", "ATM", "courier", "service center", "chartered accountant"]
        }
      },
      "slabCriteria": {
        "1": { "description": "Almost no offices, few banks/ATMs, lunch cafés <3", "indicators": ["low office presence", "URT <50", "metro >12 min"] },
        "2": { "description": "1 small office building or 1 minor coworking", "indicators": ["emerging office", "3-5 banks", "transit 10-15 min"] },
        "3": { "description": "1 business/IT park or 2-3 coworking hubs", "indicators": ["stable office catchment", "5-8 lunch cafés", "transit ≤10 min"] },
        "4": { "description": "2+ coworking hubs and/or 1 sizable business park", "indicators": ["strong office ecosystem", "8-12 lunch cafés", "transit ≤8 min"] },
        "5": { "description": "Large Grade-A park/campus or multi-tower district", "indicators": ["prime corporate zone", "12+ cafés", "transit ≤6-8 min"] }
      }
    },
    {
      "id": "vehicle_mix_mobility",
      "name": "Vehicle Mix (Mobility)",
      "description": "Vehicle composition indicating affluence and accessibility",
      "weight": 3,
      "category": "medium_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["car_dealer", "motorcycle_dealer", "car_repair", "car_wash", "parking", "gas_station"],
        "keywords": {
          "two_wheeler": ["Hero", "Honda", "TVS", "Bajaj", "Suzuki", "Yamaha"],
          "mass_4w": ["Maruti", "Hyundai", "Tata", "Kia", "Toyota"],
          "premium_4w": ["Skoda", "VW", "Jeep", "MG", "Honda Cars"],
          "luxury_4w": ["Mercedes", "BMW", "Audi", "Volvo", "Lexus", "Jaguar"]
        }
      },
      "slabCriteria": {
        "1": { "description": "VMI <30, no luxury dealers, share_2W ≥75%", "indicators": ["mass/2W-heavy", "informal parking"] },
        "2": { "description": "VMI 30-45, ≥1 mass 4W dealer, share_car 25-45%", "indicators": ["low-mid mobility", "some cars"] },
        "3": { "description": "VMI 45-65, ≥2 mass 4W dealers, balanced mix", "indicators": ["balanced mobility", "formal parking emerging"] },
        "4": { "description": "VMI 65-80, ≥1 premium dealer, share_SUV ≥20%", "indicators": ["sedan/SUV-leaning", "formal parking"] },
        "5": { "description": "VMI ≥80, ≥1 luxury dealer, share_SUV ≥30%", "indicators": ["affluent mobility", "luxury presence"] }
      }
    },
    {
      "id": "residential_society_presence",
      "name": "Residential/Society Presence",
      "description": "Quality and density of residential complexes for repeat customers",
      "weight": 7,
      "category": "high_priority",
      "searchRadius": [400, 800, 1200],
      "apiQueries": {
        "types": ["premise", "neighborhood", "political"],
        "keywords": {
          "budget": ["colony", "nagar", "gaon", "pura", "basti"],
